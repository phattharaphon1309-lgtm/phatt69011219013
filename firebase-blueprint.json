{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the user matching auth.uid"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "Email address of the user"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense record for a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique transaction ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "User ID owning this transaction"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Type of transaction: income or expense"
        },
        "amount": {
          "type": "number",
          "description": "Amount in currency (must be positive)"
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Category of the transaction"
        },
        "date": {
          "type": "string",
          "maxLength": 30,
          "description": "Date of transaction (YYYY-MM-DD)"
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional note or description"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "type", "amount", "category", "date", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User account document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "User transactions collection"
    }
  }
}
